# OpenRouter API Credentials
# Configure your OpenRouter API Key below (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Selection
# Default free high-capacity model: meta-llama/llama-3.3-70b-instruct:free
# Other supported models: google/gemini-2.0-flash-001, openai/gpt-4o-mini, deepseek/deepseek-r1:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenRouter Endpoint URL
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Firebase Project Credentials
FIREBASE_PROJECT_ID=carekey-468e8
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
